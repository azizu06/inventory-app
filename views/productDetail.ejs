<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= product.name %>></title>
  </head>
  <body>
    <%- include("navbar.ejs") %>
    <div class="flex flex-col gap-4">
      <a href="/products" class="border rounded-lg p-2">Return to Products</a>
      <div class="flex gap-4 border rounded-xl">
        <img src="<%= product.image_url %>" />
        <div class="flex flex-col gap-2">
          <div class="flex justify-between">
            <p><%= product.name %></p>
            <p>$<%= product.price %></p>
          </div>
          <p class="border-blue-400 rounded-xl p-3"><%= product.category %></p>
          <p><%= product.description %></p>
          <p>Quantity: <%= product.quantity %></p>
        </div>
      </div>
      <div class="flex w-full gap-2 justify-end">
        <a href="/products/<%= product.id %>/edit" class="border rounded-lg p-2"
          >Edit</a
        >
        <form action="/products/<%= product.id %>/delete" method="post">
          <button type="submit" class="border rounded-lg p-2">Delete</button>
        </form>
      </div>
    </div>
  </body>
</html>
