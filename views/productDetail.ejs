<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="View TechCenter product details, price, category, and inventory quantity."
    />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= product.name %> | TechCenter</title>
  </head>
  <body>
    <%- include("navbar.ejs") %>
    <% const detailDescription = product.description || "No description has been added for this product yet."; %>
    <main id="main-content" class="page-shell">
      <a href="/products" class="back-link">
        <i data-lucide="arrow-left" aria-hidden="true"></i>
        Back to products
      </a>

      <section class="detail-shell">
        <div class="detail-media">
          <img src="<%= product.image_url %>" alt="<%= product.name %>" />
        </div>

        <article class="detail-panel">
          <div class="detail-kicker">
            <span><%= product.brand || "TechCenter" %></span>
            <span><%= product.category %></span>
          </div>
          <h1><%= product.name %></h1>
          <p class="detail-price">$<%= Number(product.price).toFixed(2) %></p>
          <p class="detail-description"><%= detailDescription %></p>

          <div class="detail-stats">
            <div>
              <span>Quantity</span>
              <strong><%= product.quantity %></strong>
            </div>
            <div>
              <span>Category</span>
              <strong><%= product.category %></strong>
            </div>
          </div>

          <div class="detail-actions">
            <a href="/products/<%= product.id %>/edit" class="btn btn-primary">
              Edit product
              <span aria-hidden="true">
                <i data-lucide="pencil"></i>
              </span>
            </a>
            <form action="/products/<%= product.id %>/delete" method="post">
              <button type="submit" class="btn btn-danger">
                Delete product
              </button>
            </form>
          </div>
        </article>
      </section>
    </main>
  </body>
</html>
