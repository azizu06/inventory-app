<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Add Product</title>
  </head>
  <body>
    <%- include("navbar.ejs") %>
    <div class="flex flex-col gap-4">
      <h1>Add a Product</h1>
      <%- include("errors.ejs") %>
      <form action="/products/new" method="post" class="flex flex-col gap-2">
        <label for="name">Name:</label>
        <input
          type="text"
          name="name"
          id="name"
          value="<%= values.name %>"
          required
        />
        <label for="price">Price:</label>
        <input
          type="number"
          name="price"
          id="price"
          value="<%= values.price %>"
          required
        />
        <label for="quantity">Quantity:</label>
        <input
          type="number"
          name="quantity"
          id="quantity"
          value="<%= values.quantity %>"
          required
        />
        <label for="brand">Brand:</label>
        <input
          type="text"
          name="brand"
          id="brand"
          value="<%= values.brand %>"
        />
        <label for="description">Description:</label>
        <textarea name="description" id="description">
<%= values.description %></textarea
        >
        <label for="category">Category:</label>
        <select name="category" id="category" required>
          <% categories.forEach((cat) => {
          <% if(values.category === cat.name){ %>
          <option value="<%= cat.name %>" selected><%= cat.name %></option>
          <% } else { %>
          <option value="<%= cat.name %>"><%= cat.name %></option>
          <% } %>
          <% }) %>
        </select>
        <label for="image">Image URL:</label>
        <input
          type="text"
          name="image"
          id="image"
          value="<%= values.image %>"
        />
        <div class="flex justify-between w-full">
          <a href="/products" class="flex p-2 justify-center border rounded-lg"
            >Return to Products</a
          >
          <button
            type="submit"
            class="flex p-2 justify-center border rounded-lg"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </body>
</html>
