<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= product.name %>></title>
  </head>
  <body>
    <%- include("navbar.ejs") %>
    <div class="flex flex-col gap-4">
      <a href="/products/<%= product.id %>" class="border rounded-lg p-2"
        >Return to
        <%= product.name %></a
      >
      <div class="flex gap-4 border rounded-xl">
        <img src="<%= product.image_url %>" />
        <%- include("errors.ejs") %>
        <form
          method="post"
          action="/products/<%= product.id %>/edit"
          class="flex flex-col gap-2"
        >
          <div class="flex justify-between">
            <p><%= product.name %></p>
            <div class="flex gap-1">
              <label for="price">$</label>
              <input
                type="number"
                name="price"
                id="price"
                value="<%= values.price %>"
              />
            </div>
          </div>
          <select
            name="category_id"
            id="category_id"
            class="border-blue-400 rounded-xl p-3"
          >
            <% categories.forEach((cat) => { %>
            <% if(Number(values.category_id) === cat.id){ %>
            <option value="<%= cat.id %>" selected>
              <%= cat.name %>
            </option>
            <% } else { %>
            <option value="<%= cat.id %>"><%= cat.name %></option>
            <% } %>
            <% }) %>
          </select>
          <label for="brand"></label>
          <input
            type="text"
            name="brand"
            id="brand"
            value="<%= values.brand %>"
          />
          <textarea name="description" id="description">
<%= values.description %></textarea
          >
          <div class="flex gap-1">
            <label for="quantity">Quantity:</label>
            <input
              type="number"
              name="quantity"
              id="quantity"
              value="<%= values.quantity %>"
            />
          </div>
          <button class="w-full flex justify-center border rounded-lg p-2">
            Submit Edits
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
